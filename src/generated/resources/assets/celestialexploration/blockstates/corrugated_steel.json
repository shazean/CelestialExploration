{
  "multipart": [
    {
      "apply": {
        "model": "celestialexploration:block/corrugated_steel_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "celestialexploration:block/corrugated_steel_side"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "celestialexploration:block/corrugated_steel_noside"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "celestialexploration:block/corrugated_steel_side_alt"
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "celestialexploration:block/corrugated_steel_noside_alt",
        "y": 90
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "celestialexploration:block/corrugated_steel_side_alt",
        "y": 90
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "celestialexploration:block/corrugated_steel_noside",
        "y": 270
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "celestialexploration:block/corrugated_steel_side",
        "y": 90
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "celestialexploration:block/corrugated_steel_noside_alt"
      }
    }
  ]
}